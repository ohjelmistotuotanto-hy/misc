{
  "$schema": "https://opencode.ai/config.json",
  "model": "currechat/gpt-5-mini",
  "provider": {
    "currechat": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CurreChat",
      "options": {
        "baseURL": "https://curre.helsinki.fi/chat/api/external/v1",
        "apiKey": "OMA_API_AVAIN"
      },
      "models": {
        "gpt-5-mini": {
          "name": "GPT-5 mini",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-5.5": {
          "name": "GPT-5.5",
          "limit": { "context": 128000, "output": 16384 }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": { "context": 128000, "output": 16384 }
        },
        "Mistral-Large-3-1": {
          "name": "Mistral Large 3.1",
          "limit": { "context": 128000, "output": 8192 }
        }
      }
    }
  }
}
