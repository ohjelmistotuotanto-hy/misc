{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/gpt-5-mini",
  "providers": {
    "local": {
      "name": "CurreChat API",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://curre.helsinki.fi/chat/api/external/v1",
        "apiKey": "<YOUR API KEY OR SUBSTITUTION HERE>"
      },
      "models": {
        "gpt-5-mini": {
          "modelID": "gpt-5-mini",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-5.5": {
          "modelID": "gpt-5.5",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-6.1-sol": {
          "modelID": "gpt-6.1-sol",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "mistral-large-3-1": {
          "modelID": "Mistral-Large-3-1",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  }
}